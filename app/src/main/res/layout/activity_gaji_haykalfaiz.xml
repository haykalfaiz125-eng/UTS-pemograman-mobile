<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_card_haykalfaiz"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/header_gaji_karyawan"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/etNik"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:hint="@string/hint_nik"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etNama"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:hint="@string/hint_nama"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etGajiPokok"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:hint="@string/hint_gaji_pokok"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etTunjanganJabatan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:hint="@string/hint_tunjangan_jabatan"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etJumlahHariKerja"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:hint="@string/hint_jumlah_hari_kerja"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <Button
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0072C6"
            android:text="@string/btn_hitung"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/etTunjanganMakan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:focusable="false"
            android:hint="@string/hint_tunjangan_makan"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etTunjanganTransport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:focusable="false"
            android:hint="@string/hint_tunjangan_transportasi"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etGajiKotor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:focusable="false"
            android:hint="@string/hint_gaji_kotor"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <EditText
            android:id="@+id/etGajiBersih"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_edittext_haykalfaiz"
            android:focusable="false"
            android:hint="@string/hint_gaji_bersih"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:textSize="14sp" />


        <Button
            android:id="@+id/btnKembaliGaji"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#D6D6D6"
            android:text="@string/btn_kembali"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>